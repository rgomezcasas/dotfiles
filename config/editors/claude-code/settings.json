{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "IS_DEMO": "1",
    "MAX_THINKING_TOKENS": "64000"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(agent-browser *)",
      "Bash(ast-grep *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Grep",
      "WebSearch",
      "Bash(sudo darwin-rebuild:*)",
      "WebFetch(domain:nix-darwin.github.io)",
      "Read(//Users/rafa.gomez/.config/**)",
      "Read(//Users/rafa.gomez/**)",
      "Bash(find /nix/store -type f \\\\\\(-name *finder* -o -name *defaults* \\\\\\))",
      "Bash(git commit:*)",
      "Bash(defaults read:*)",
      "Bash($HOME/.dotfiles/scripts/system/sdot mac:*)",
      "Bash(grep -v \"^$\")",
      "Bash(swift:*)",
      "Bash(plutil -p /Library/Preferences/com.apple.ncprefs.plist)",
      "Bash(plutil -p ~/Library/Preferences/com.apple.notificationcenterui.plist)",
      "Bash(defaults domains:*)",
      "WebFetch(domain:derflounder.wordpress.com)",
      "WebFetch(domain:docs.automox.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:developer.okta.com)",
      "Bash(nix eval:*)",
      "Bash(mdfind -name ncprefs.plist)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(nm /System/Library/ExtensionKit/Extensions/NotificationsSettings.appex/Contents/MacOS/NotificationsSettings)",
      "Bash(defaults -currentHost read com.apple.notificationcenterui turnOnDNDWhenMirroring)",
      "Bash(plutil:*)",
      "WebFetch(domain:droidwin.com)",
      "WebFetch(domain:community.jamf.com)",
      "Bash(defaults find:*)",
      "Bash(grep -r npo /Users/rafa.gomez/.dotfiles --include=*.sh --include=*.json --include=*.edn)",
      "WebFetch(domain:ghostty.org)",
      "Bash(curl -s https://ghostty.org/docs/features/applescript)",
      "Bash(grep -r alias /Users/rafa.gomez/.dotfiles/config/shell/ --include=*.sh)",
      "Bash(sdef /Applications/Ghostty.app)",
      "Bash(/Applications/Ghostty.app/Contents/MacOS/ghostty +list-actions)",
      "Bash(networksetup -listallhardwareports)",
      "Bash(networksetup -getairportnetwork en0)",
      "Bash(route -n get default)",
      "Bash(nix-env -qaP)"
    ],
    "deny": [
      "Bash(git *--amend*)",
      "Bash(git push*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "default"
  ],
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "generate-doc": "off",
    "global-clean-pr-commits": "off",
    "agent-browser": "off"
  },
  "enableArtifact": false,
  "defaultShell": "bash",
  "statusLine": {
    "type": "command",
    "command": "bash /Users/rafa.gomez/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "tsgo-lsp@dotfiles": true
  },
  "extraKnownMarketplaces": {
    "home-assistant-skills": {
      "source": {
        "source": "github",
        "repo": "homeassistant-ai/skills"
      }
    },
    "unifi-plugins": {
      "source": {
        "source": "github",
        "repo": "sirkirby/unifi-mcp"
      }
    },
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/rafa.gomez/.dotfiles/config/agents/plugins"
      }
    }
  },
  "language": "english",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "docker",
      "git"
    ]
  },
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Codelyting",
      "<🦄> Codelyteando",
      "🫧 Javiersiteandooo",
      "🐾 Rubényveteando",
      "💂‍♂️ Rafiteandooo",
      "🐢💨 Turbotugueando",
      "{▸} CodelyTVing",
      "Niño, niño, niño"
    ]
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": true,
  "companyAnnouncements": [
   "Long life Codely!"
  ],
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "autoScrollEnabled": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
